{
    "name": "@rcm/listgrid",
    "version": "0.1.0-alpha.39",
    "private": true,
    "description": "Generic ListGrid engine — reusable CRUD UI engine for the RCM-framework backend",
    "license": "UNLICENSED",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./next": {
            "types": "./dist/adapters/next/index.d.ts",
            "default": "./dist/adapters/next/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./styles/tokens.css": "./dist/styles/tokens.css",
        "./styles/primitives.css": "./dist/styles/primitives.css",
        "./styles/layouts.css": "./dist/styles/layouts.css",
        "./styles/components.css": "./dist/styles/components.css",
        "./styles/base.css": "./dist/styles/base.css"
    },
    "files": [
        "dist",
        "README.md",
        "DECISIONS.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/rchemist/rchemist-rcm-listgrid-release"
    },
    "scripts": {
        "type-check": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json && npm run build:styles",
        "build:styles": "mkdir -p dist/styles && cp src/listgrid/styles/tokens.css src/listgrid/styles/primitives.css src/listgrid/styles/layouts.css src/listgrid/styles/components.css src/listgrid/styles/base.css dist/styles/ && cat src/listgrid/styles/tokens.css src/listgrid/styles/primitives.css src/listgrid/styles/layouts.css src/listgrid/styles/components.css src/listgrid/styles/base.css > dist/styles.css",
        "clean": "rm -rf dist",
        "deploy": "./deploy.sh"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "crypto-js": "^4.2.0",
        "tailwind-merge": "^2.5.4",
        "uuid": "^9.0.0",
        "zustand": "^4.4.0"
    },
    "peerDependencies": {
        "@headlessui/react": "^2.0.0",
        "@iconify/react": "^4.0.0 || ^5.0.0",
        "@tabler/icons-react": "^2.30.0 || ^3.0.0",
        "date-fns": "^2.0.0 || ^3.0.0 || ^4.0.0",
        "file-saver": "^2.0.5",
        "next": ">=14",
        "nuqs": ">=2.0.0",
        "qrcode.react": "^3.0.0 || ^4.0.0",
        "react": ">=18",
        "react-daum-postcode": "^3.0.0",
        "react-dom": ">=18",
        "react-kakao-maps-sdk": "^1.0.0",
        "react-select": "^5.0.0",
        "react-sortablejs": "^6.0.0 || ^7.0.0",
        "sweetalert2": "^11.0.0",
        "sweetalert2-react-content": "^5.0.0",
        "xlsx-js-style": "^1.2.0"
    },
    "peerDependenciesMeta": {
        "@tabler/icons-react": {
            "optional": false
        },
        "@headlessui/react": {
            "optional": false
        },
        "next": {
            "optional": true
        },
        "nuqs": {
            "optional": true
        },
        "@iconify/react": {
            "optional": true
        },
        "react-select": {
            "optional": true
        },
        "react-sortablejs": {
            "optional": true
        },
        "qrcode.react": {
            "optional": true
        },
        "react-kakao-maps-sdk": {
            "optional": true
        },
        "react-daum-postcode": {
            "optional": true
        },
        "xlsx-js-style": {
            "optional": true
        },
        "file-saver": {
            "optional": true
        },
        "sweetalert2": {
            "optional": true
        },
        "sweetalert2-react-content": {
            "optional": true
        }
    },
    "devDependencies": {
        "@headlessui/react": "^2.2.9",
        "@iconify/react": "^4.1.1",
        "@tabler/icons-react": "^2.30.0",
        "@types/crypto-js": "^4.2.2",
        "@types/file-saver": "^2.0.7",
        "@types/node": "^22.0.2",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.0",
        "@types/sortablejs": "^1.15.9",
        "@types/uuid": "^9.0.0",
        "date-fns": "^3.6.0",
        "file-saver": "^2.0.5",
        "next": "^15.0.0",
        "nuqs": "^2.0.0",
        "qrcode.react": "^3.1.0",
        "react": "^19.2.1",
        "react-daum-postcode": "^3.1.3",
        "react-dom": "^19.2.1",
        "react-kakao-maps-sdk": "^1.1.27",
        "react-select": "^5.10.2",
        "react-sortablejs": "^6.1.4",
        "sortablejs": "^1.15.7",
        "sweetalert2": "^11.6.13",
        "sweetalert2-react-content": "^5.0.7",
        "typescript": "^5.5.0",
        "xlsx-js-style": "^1.2.0"
    }
}
