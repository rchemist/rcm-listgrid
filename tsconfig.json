{
    "compilerOptions": {
        "target": "es2020",
        "lib": ["es2020", "dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "strict": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "declaration": true,
        "declarationMap": true,
        "baseUrl": "."
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "tests/**/*.ts",
        "tests/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "packages",
        "apps",
        "tests/headless",
        "**/__tests__/**",
        "**/*.test.ts",
        "**/*.test.tsx"
    ],
    "references": [
        { "path": "./packages/schema-core" },
        { "path": "./packages/state" },
        { "path": "./packages/react" },
        { "path": "./packages/ui-default" },
        { "path": "./packages/backend-rcm" },
        { "path": "./packages/backend-rest" },
        { "path": "./packages/presets-rcm" },
        { "path": "./packages/next" },
        { "path": "./packages/excel" }
    ]
}
